<Window x:Class="AIStockTrader.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIStockTrader.WPF"
        xmlns:viewModels="clr-namespace:AIStockTrader.WPF.ViewModels"
        mc:Ignorable="d"
        Title="AI智能炒股助手" Height="700" Width="450"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#2D2D3D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D4AA"/>
        <SolidColorBrush x:Key="UpBrush" Color="#FF4444"/>
        <SolidColorBrush x:Key="DownBrush" Color="#44AA44"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0A0B0"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3D3D4D"/>

        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <local:ScoreToColorConverter x:Key="ScoreToColorConverter"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,5"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TitleLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StockNameStyle" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StockPriceStyle" TargetType="Label">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="UpDownStyle" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D3D" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="📈 AI智能炒股助手" Style="{StaticResource TitleLabelStyle}"/>
                    <Label Content="实时行情 · 智能分析 · 精准决策" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="White"
                        Width="30" Height="30" Click="CloseWindow" FontSize="16" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Search Bar -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,10,0"/>
                        <Button Grid.Column="1"
                                Content="搜索"
                                Style="{StaticResource ButtonStyle}"
                                Command="{Binding SearchCommand}"/>
                    </Grid>
                </Border>

                <!-- Stock Info Card -->
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding SelectedStockQuote, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="{Binding SelectedStockQuote.Name}" Style="{StaticResource StockNameStyle}"/>
                                <Label Content="{Binding SelectedStockQuote.Code}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Label Content="{Binding SelectedStockQuote.CurrentPrice, StringFormat={}{0:F2}}"
                                       Style="{StaticResource StockPriceStyle}"
                                       Foreground="{Binding SelectedStockQuote.IsUp, Converter={StaticResource BoolToColorConverter}}"/>
                                <Label Content="{Binding SelectedStockQuote.ChangePercent, StringFormat={}{0:+0.00%;-0.00%;0.00}%}"
                                       Style="{StaticResource UpDownStyle}"
                                       Foreground="{Binding SelectedStockQuote.IsUp, Converter={StaticResource BoolToColorConverter}}"
                                       Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Rectangle Fill="{StaticResource BorderBrush}" Height="1" Margin="0,15" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="今开" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <Label Grid.Row="0" Grid.Column="1" Content="最高" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="最低" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="{Binding SelectedStockQuote.OpenPrice, StringFormat={}{0:F2}}" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                            <Label Grid.Row="1" Grid.Column="1" Content="{Binding SelectedStockQuote.HighPrice, StringFormat={}{0:F2}}" Foreground="{StaticResource UpBrush}" FontSize="14"/>
                            <Label Grid.Row="1" Grid.Column="2" Content="{Binding SelectedStockQuote.LowPrice, StringFormat={}{0:F2}}" Foreground="{StaticResource DownBrush}" FontSize="14"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- AI Analysis Button -->
                <Button Content="🤖 AI智能分析"
                        Style="{StaticResource ButtonStyle}"
                        Margin="10"
                        Command="{Binding AnalyzeCommand}"
                        Visibility="{Binding SelectedStockQuote, Converter={StaticResource NullToVisibilityConverter}}"/>

                <!-- Analysis Result Card -->
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding CurrentAnalysis, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <Label Content="📊 AI分析报告" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="综合评分" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                                <Label Content="{Binding CurrentAnalysis.Score, StringFormat={}{0:F1}}"
                                       FontSize="42" FontWeight="Bold"
                                       Foreground="{Binding CurrentAnalysis.Score, Converter={StaticResource ScoreToColorConverter}}"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <Label Content="AI建议" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                                <Label Content="{Binding CurrentAnalysis.RecommendationText}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Rectangle Fill="{StaticResource BorderBrush}" Height="1" Margin="0,15" />

                        <Label Content="技术指标" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>

                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="MACD" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <Label Grid.Row="0" Grid.Column="1" Content="RSI(14)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="{Binding CurrentAnalysis.MACDValue, StringFormat={}{0:F4}}" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                            <Label Grid.Row="1" Grid.Column="1" Content="{Binding CurrentAnalysis.RSIValue, StringFormat={}{0:F2}}" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="MA5" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <Label Grid.Row="2" Grid.Column="1" Content="MA20" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <Label Grid.Row="3" Grid.Column="0" Content="{Binding CurrentAnalysis.MA5, StringFormat={}{0:F2}}" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                            <Label Grid.Row="3" Grid.Column="1" Content="{Binding CurrentAnalysis.MA20, StringFormat={}{0:F2}}" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                        </Grid>

                        <Rectangle Fill="{StaticResource BorderBrush}" Height="1" Margin="0,15" />

                        <Label Content="分析理由" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding CurrentAnalysis.Reason}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <Rectangle Fill="{StaticResource BorderBrush}" Height="1" Margin="0,15" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="可信度" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                                <Label Content="{Binding CurrentAnalysis.Confidence, StringFormat={}{0:F0}%}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                            <Label Grid.Column="1" Content="{Binding CurrentAnalysis.AnalysisTime, StringFormat=分析时间: {0:HH:mm:ss}}"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                                   VerticalAlignment="Bottom"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Popular Stocks -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Label Content="⭐ 热门股票" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                        <ListBox ItemsSource="{Binding WatchlistStocks}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Cursor="Hand" MouseDown="OnStockSelected">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#3D3D4D"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Label Content="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="Bold"/>
                                                <Label Content="{Binding Code}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <Label Content="{Binding CurrentPrice, StringFormat={}{0:F2}}" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="Bold"/>
                                                <Label Content="{Binding ChangePercent, StringFormat={}{0:+0.00%;-0.00%;0.00}%}"
                                                       FontSize="12"
                                                       Foreground="{Binding IsUp, Converter={StaticResource BoolToColorConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Rectangle Height="60" Fill="Transparent"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#2D2D3D" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ProgressBar Width="20" Height="20" IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,10,0"/>
                <Label Content="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
